{
  "version": 2,
  "name": "cloudflare",
  "allow": {"api.cloudflare.com": true},
  "routes": {
    "cloudflare": {
      "host": "api.cloudflare.com",
      "upstream": "https://api.cloudflare.com",
      "credentialFile": "/run/secrets/cloudflare-token",
      "placeholder": "proxy-injected",
      "refusal": {"contentType": "application/json", "body": "{\"success\":false,\"errors\":[{\"code\":403,\"message\":\"{{message}}\"}]}"},
      "paths": {
        "DELETE /client/v4/zones/*/dns_records/*": {"operation": {"id": "dns-records-for-a-zone-delete-dns-record", "summary": "Delete DNS Record",
                       "description": "Permanently removes a DNS record from the zone.", "class": "guarded", "category": "DNS Records for a Zone"}},
        "PATCH /client/v4/zones/*/dns_records/*": {"operation": {"id": "dns-records-for-a-zone-patch-dns-record", "summary": "Update DNS Record", "class": "write", "category": "DNS Records for a Zone"}},
        "GET /client/v4/zones": {"operation": {"id": "zones-get", "summary": "List Zones", "class": "read", "category": "Zone"}},
        "DELETE /client/v4/zones/*": {"operation": {"id": "zones-0-delete", "summary": "Delete Zone", "class": "guarded", "category": "Zone"}}
      },
      "operations": {
        "GET,HEAD /client/v4/zones/*/dns_records/*": "allow",
        "POST /client/v4/accounts/**": "refuse",
        "category:DNS Records for a Zone": "allow",
        "dns-records-for-a-zone-delete-dns-record": "ask",
        "zones-0-delete": "refuse"
      },
      "writes": "allow",
      "guarded": "allow",
      "unmatched": "ask"
    }
  }
}
