{
  "version": 2,
  "name": "google",
  "allow": {"**.googleapis.com": true, "accounts.google.com": true},
  "routes": {
    "google": {
      "host": "**.googleapis.com",
      "upstream": "https://**.googleapis.com",
      "credentialFile": "/run/secrets/gcp-token.json",
      "credentialJSON": {"token": "access_token", "expiresMillis": "expiry"},
      "placeholder": "proxy-injected",
      "encodedSlashes": {"/storage/v1/b/*/o/*": true},
      "paths": {
        "GET /v1/projects/*/secrets/*/versions/*": {"operation": {"id": "get", "summary": "Get a version", "class": "read", "category": "versions"}},
        "GET /v1/projects/*/secrets/*/versions/*:access": {"operation": {"id": "access", "summary": "Access a version", "class": "guarded", "category": "versions"}},
        "GET /v1/projects/*/secrets/*/versions/latest:access": {"operation": {"id": "latest", "summary": "Access the latest version", "class": "guarded", "category": "versions"}},
        "POST /v1/projects/*/secrets/*:addVersion": {"operation": {"id": "add", "summary": "Add a version", "class": "write", "category": "secrets"}},
        "GET /v1/projects/*/locations/*:list/**": {"operation": {"id": "locations", "summary": "List locations", "class": "read", "category": "locations"}},
        "GET /v1/projects/*/secrets/*": {"operation": {"id": "secret", "summary": "Get a secret", "class": "read", "category": "secrets"}},
        "GET /v1/projects/*/secrets/*:getIamPolicy": {"operation": {"id": "policy", "summary": "Get a secret's policy", "class": "read", "category": "secrets"}},
        "GET /storage/v1/b/*/o/*": {"operation": {"id": "objects-get", "summary": "Get an object", "class": "read", "category": "objects"}}
      },
      "operations": {
        "access": "refuse",
        "latest": "ask",
        "add": "ask",
        "secret": "ask"
      },
      "guarded": "refuse",
      "unmatched": "ask"
    },
    "google-mtls": {
      "host": "**.mtls.googleapis.com",
      "upstream": "https://**.mtls.googleapis.com",
      "operations": {"GET,HEAD,POST,PUT,PATCH,DELETE /**": "refuse"}
    }
  }
}
